<?xml version="1.0" encoding="UTF-8"?>
<!-- SCORM-1.2-Paket für Moodle: eine Lerneinheit (index.html). Sie speichert Quelltext und Einstellungen in Moodle
     und meldet sich als abgeschlossen, sobald ein Programm bis end gelaufen ist. -->
<manifest identifier="igse-neomops" version="1.0"
          xmlns="http://www.imsproject.org/xsd/imscp_rootv1p1p2"
          xmlns:adlcp="http://www.adlnet.org/xsd/adlcp_rootv1p2"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://www.imsproject.org/xsd/imscp_rootv1p1p2 imscp_rootv1p1p2.xsd
                              http://www.adlnet.org/xsd/adlcp_rootv1p2 adlcp_rootv1p2.xsd">
  <metadata>
    <schema>ADL SCORM</schema>
    <schemaversion>1.2</schemaversion>
  </metadata>
  <organizations default="org-neomops">
    <organization identifier="org-neomops">
      <title>Neo-MOPS – Modellrechner</title>
      <item identifier="item-neomops" identifierref="res-neomops" isvisible="true">
        <title>Neo-MOPS – Modellrechner</title>
      </item>
    </organization>
  </organizations>
  <resources>
    <resource identifier="res-neomops" type="webcontent" adlcp:scormtype="sco" href="index.html">
      <file href="index.html"/>
    </resource>
  </resources>
</manifest>
